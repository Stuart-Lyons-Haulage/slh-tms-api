{
  "LocalTest": {
    "Enabled": true,
    "EnableExternalIntegrations": false,
    "AllowExternalWrites": false
  },
  "Deployment": {
    "Revision": "local-server-edition"
  },
  "Entra": {
    "TenantId": "local-test",
    "Audience": "local-test",
    "AllowedDomains": [
      "lyonshaulage.com",
      "stuartlyonshaulage.co.uk"
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://127.0.0.1:5173",
      "http://localhost:5173"
    ]
  },
  "LocalStorage": {
    "Enabled": true,
    "Root": "./local-data/customer-files",
    "DatabaseRoot": "./local-data/data"
  },
  "Tracking": {
    "Dot": {
      "Enabled": false
    }
  },
  "Integrations": {
    "TachoMaster": {
      "Enabled": false
    },
    "SageHr": {
      "Enabled": false
    },
    "Fleetio": {
      "Enabled": false
    },
    "OpenAI": {
      "Enabled": false
    },
    "AzureSms": {
      "Enabled": false
    },
    "TextBee": {
      "Enabled": false
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TmsDb": "Server=(localdb)\\\\MSSQLLocalDB;Database=SLH_TMS_LOCAL;Integrated Security=true;TrustServerCertificate=true;MultipleActiveResultSets=true"
  }
}
